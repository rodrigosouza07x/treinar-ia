# ==============================================================================
# CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE - TREINAR SERVIÇOS
# ==============================================================================
# Copie este arquivo para .dev.vars ao executar localmente:
# cp .dev.vars.example .dev.vars
# E preencha com a sua chave real. NUNCA envie o arquivo .dev.vars para o Git.

# 1. API do Google Gemini (Obrigatório)
# Obtenha gratuitamente em: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSySuaChaveAqui

# 2. Modelo do Gemini (Obrigatório)
# Modelo padrão recomendado com cota gratuita no Google AI Studio
# Sempre confira os modelos ativos disponíveis no Google AI Studio.
GEMINI_MODEL=gemini-2.5-flash

# 3. Limites de Proteção Anti-Abuso (Otimizados para Cloudflare KV Free Tier)
# O plano gratuito do KV tem 1.000 gravações por dia.
# Cada mensagem consome 2 gravações (1 para o registro diário do IP + 1 para o total global diário).
# Com LIMIT_GLOBAL_DAILY=400, o consumo máximo é de 800 gravações/dia (margem segura).
LIMIT_PER_HOUR=20
LIMIT_PER_DAY=50
LIMIT_GLOBAL_DAILY=400

# 4. Modo de Desenvolvimento (Opcional)
# Defina como "true" para desligar todas as checagens e limites em desenvolvimento local
DISABLE_PROTECTIONS=false

# 5. Cloudflare Turnstile e Cookie HMAC (Opcionais)
# Preencha somente se for utilizar o Turnstile (Cloudflare Captcha Invisível)
# Se preenchido, gere um COOKIE_SECRET longo e aleatório (ex.: 32+ caracteres)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
COOKIE_SECRET=segredo_para_cookie_hmac_32_caracteres_aleatorios
